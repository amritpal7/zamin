# ─── Copy this to .env and fill in your values ───────────────
# Get Clerk keys from: https://dashboard.clerk.com → API Keys

# Clerk (both keys needed)
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Your machine's LAN IP so Expo Go on your phone can connect
# Run: ipconfig getifaddr en0  (Mac) or hostname -I (Linux)
HOST_IP=192.168.1.100

# Postgres (change in production)
POSTGRES_USER=zamin
POSTGRES_PASSWORD=zamin_pass
POSTGRES_DB=zamin_db
