# ─── Copy this to .env and fill in your values ───────────────
# Get Clerk keys from: https://dashboard.clerk.com → API Keys

# Clerk (both keys needed)
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Your machine's LAN IP so Expo Go on your phone can connect
# Run: ipconfig getifaddr en0  (Mac) or hostname -I (Linux)
HOST_IP=192.168.1.100

# Postgres (change in production)
POSTGRES_USER=zamin
POSTGRES_PASSWORD=zamin_pass
POSTGRES_DB=zamin_db

# MinIO / object storage (change in production)
MINIO_ROOT_USER=zamin_minio
MINIO_ROOT_PASSWORD=zamin_minio_secret

# ─── Security / ops (optional; sensible defaults) ────────────
# CORS allow-list (comma-separated). Default "*" for dev; set known origins in prod.
CORS_ORIGIN=*
# Per-IP requests per minute before 429 (default 600).
RATE_LIMIT_MAX=600
# Set to "production" so error responses don't leak internals.
# NODE_ENV=production
# How often the worker reconciles owner liveness (ms; default 6h).
# RECONCILE_INTERVAL_MS=21600000
