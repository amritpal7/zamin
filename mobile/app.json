{
  "expo": {
    "name": "Zamin",
    "slug": "zamin",
    "version": "1.0.0",
    "scheme": "zamin",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0f",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zamin.app",
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Zamin uses your location to show nearby properties.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zamin.app",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_KEY"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zamin needs access to your photos so you can add images to your property listings."
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zamin uses your location to show nearby property listings."
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0f",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "organization": "aps-6c",
          "project": "zamin-mobile"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48189e32-e886-468b-9921-4d59d06dbac9"
      }
    },
    "owner": "mramrrit007"
  }
}
